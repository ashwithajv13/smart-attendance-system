# App
APP_ENV=development
DEBUG=True

# Security — CHANGE THIS in production
SECRET_KEY=smart-attendance-secret-key-2024-change-me
JWT_ALGORITHM=HS256

# QR token expiry (minutes)
QR_TOKEN_EXPIRY_MINUTES=10

# Database (SQLite — relative path resolved in app.py)
DATABASE_URL=sqlite:///database/attendance.db

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# Face — cosine similarity threshold (0.0–1.0, higher = stricter)
# face-api.js FaceNet produces 128-d L2-normalised vectors
# cosine similarity >= 0.75 is a reliable match
FACE_THRESHOLD=0.75

# GPS — allowed radius in metres from classroom coordinates
GPS_RADIUS_METRES=100

# CORS
CORS_ORIGINS=*
